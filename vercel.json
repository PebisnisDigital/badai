{
  "routes": [
    {
      "src": "^/api/wa-marketing/?$",
      "dest": "/api/admin-v5?__wa_marketing=status"
    },
    {
      "src": "^/api/mentor/(.*)$",
      "dest": "https://badai.up.railway.app/api/mentor/$1"
    },
    {
      "src": "^/api/community/(.*)$",
      "dest": "https://badai.up.railway.app/api/community/$1"
    },
    {
      "src": "^/api/profile/(.*)$",
      "dest": "https://badai.up.railway.app/api/profile/$1"
    },
    {
      "src": "^/api/admin/ai/(.*)$",
      "dest": "https://badai.up.railway.app/api/admin/ai/$1"
    },
    {
      "src": "^/api/admin/mentor-identity/avatar$",
      "dest": "https://badai.up.railway.app/api/admin/mentor-identity/avatar"
    },
    {
      "src": "^/api/admin/chat/permanent-delete$",
      "dest": "https://badai.up.railway.app/api/admin/chat/permanent-delete"
    },
    {
      "src": "^/admin/?$",
      "dest": "/api/admin-v5"
    },
    {
      "src": "^/game-edukatif/?$",
      "dest": "/game-edukatif/index.html"
    },
    {
      "src": "^/akses/?$",
      "dest": "/api/admin-v3?accesscompact=1"
    },
    {
      "src": "^/buatqris-verify-7c7a191a8da43b57bf28704876b92857\\.txt$",
      "dest": "/buatqris-verify-7c7a191a8da43b57bf28704876b92857.txt"
    },
    {
      "src": "^/$",
      "dest": "/api/landing-v6"
    },
    {
      "src": "^/wa-marketing-admin\\.js$",
      "dest": "/wa-marketing-admin.js"
    },
    {
      "src": "^/wa-zawa-ui\\.js$",
      "dest": "/wa-zawa-ui.js"
    },
    {
      "src": "^/wa-channel-admin\\.css$",
      "dest": "/wa-channel-admin.css"
    },
    {
      "src": "^/wa-channel-admin\\.js$",
      "dest": "/wa-channel-admin.js"
    },
    {
      "src": "^/admin-workspace\\.css$",
      "dest": "/admin-workspace.css"
    },
    {
      "src": "^/[^/]+/?$",
      "dest": "/api/landing-v6"
    },
    {
      "handle": "filesystem"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "staging": false
    }
  }
}
